<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pricelist_page_image" inherit_id="product.report_pricelist_page">
        <xpath expr="//th[contains(normalize-space(.), 'Products')]" position="after">
            <th class="text-center" style="width:130px;">Image</th>
        </xpath>
        <xpath expr="//t[@t-foreach='products']//td[1]" position="after">
            <td class="text-center">
                <img t-if="product.get('image_url')" t-att-src="product['image_url']"
                     width="100" height="100" style="width:100px; height:100px; object-fit:contain;" alt=""/>
            </td>
        </xpath>
        <xpath expr="//*[@t-as='variant']//td[1]" position="after">
            <td class="text-center">
                <img t-if="variant.get('image_url')" t-att-src="variant['image_url']"
                     width="80" height="80" style="width:80px; height:80px; object-fit:contain;" alt=""/>
            </td>
        </xpath>
    </template>
</odoo>
