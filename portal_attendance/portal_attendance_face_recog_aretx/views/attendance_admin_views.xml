<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_selfie_geo" model="ir.ui.view">
        <field name="name">hr.attendance.list.selfie.geo</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="latitude" optional="show"/>
                <field name="longitude" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="out_latitude" optional="show"/>
                <field name="out_longitude" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_attendance_form_selfie_geo" model="ir.ui.view">
        <field name="name">hr.attendance.form.selfie.geo</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="check_in_image" widget="image" options="{'size': [200, 200]}"/>
                <field name="out_latitude"/>
                <field name="out_longitude"/>
                <field name="check_out_image" widget="image" options="{'size': [200, 200]}"/>
            </xpath>
        </field>
    </record>
</odoo>
