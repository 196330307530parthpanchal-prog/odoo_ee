<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Complain Types -->
    <record id="hr_complaint_type_view_list" model="ir.ui.view">
        <field name="name">hr.complaint.type.list</field>
        <field name="model">hr.complaint.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hr_complaint_type_view_form" model="ir.ui.view">
        <field name="name">hr.complaint.type.form</field>
        <field name="model">hr.complaint.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_complaint_type_action" model="ir.actions.act_window">
        <field name="name">Complain Types</field>
        <field name="res_model">hr.complaint.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Complaints -->
    <record id="hr_complaint_view_list" model="ir.ui.view">
        <field name="name">hr.complaint.list</field>
        <field name="model">hr.complaint</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="complaint_type_id"/>
                <field name="severity" widget="badge"
                       decoration-success="severity == 'low'"
                       decoration-warning="severity == 'moderate'"
                       decoration-danger="severity == 'high'"/>
            </list>
        </field>
    </record>

    <record id="hr_complaint_view_form" model="ir.ui.view">
        <field name="name">hr.complaint.form</field>
        <field name="model">hr.complaint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="complaint_type_id"/>
                        </group>
                        <group>
                            <field name="severity"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe the complaint..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_complaint_view_search" model="ir.ui.view">
        <field name="name">hr.complaint.search</field>
        <field name="model">hr.complaint</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="complaint_type_id"/>
                <filter string="Low" name="low" domain="[('severity', '=', 'low')]"/>
                <filter string="Moderate" name="moderate" domain="[('severity', '=', 'moderate')]"/>
                <filter string="High" name="high" domain="[('severity', '=', 'high')]"/>
                <group string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Complaint Type" name="group_type" context="{'group_by': 'complaint_type_id'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_complaint_action" model="ir.actions.act_window">
        <field name="name">Complaints</field>
        <field name="res_model">hr.complaint</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus: Employees > Configuration > Complaints -->
    <menuitem id="menu_hr_complaints_root"
              name="Complaints"
              parent="hr.menu_human_resources_configuration"
              groups="hr.group_hr_user"
              sequence="90"/>

    <menuitem id="menu_hr_complaint"
              name="Complaints"
              parent="menu_hr_complaints_root"
              action="hr_complaint_action"
              groups="hr.group_hr_user"
              sequence="1"/>

    <menuitem id="menu_hr_complaint_type"
              name="Complain Types"
              parent="menu_hr_complaints_root"
              action="hr_complaint_type_action"
              groups="hr.group_hr_user"
              sequence="2"/>
</odoo>