<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_hr_leave_type_form_pharma" model="ir.ui.view">
        <field name="name">hr.leave.type.form.pharma.custom</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>

        <field name="arch" type="xml">

            <xpath expr="//group[@name='configuration']" position="inside">

                <field name="max_time_off"/>

                <field name="cannot_be_combined_with_ids"
                    widget="many2many_tags"
                    options="{'no_create_edit': True}"
                    domain="[('id', '!=', id)]"/>

                <field name="applied_before"/>

                <field name="abbreviation"/>

            </xpath>

        </field>
    </record>

</odoo>