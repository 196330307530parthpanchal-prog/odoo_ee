<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Add Shift popup / Planning shift form.
        Shift Assigned is a related field coming from the selected template.
        It is intentionally readonly: the template remains the source.
    -->
    <record id="planning_slot_shift_assigned_form" model="ir.ui.view">
        <field name="name">planning.slot.shift.assigned.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="shift_assigned"/>
            </xpath>
        </field>
    </record>

    <!-- Shift Assigned in Planning list -->
    <record id="planning_slot_shift_assigned_tree" model="ir.ui.view">
        <field name="name">planning.slot.shift.assigned.tree</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="shift_assigned" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
