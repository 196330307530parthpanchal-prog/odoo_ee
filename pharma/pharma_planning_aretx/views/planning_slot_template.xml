<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Shift Assigned in Planning Shift Template list -->
    <record id="planning_slot_template_shift_assigned_tree" model="ir.ui.view">
        <field name="name">planning.slot.template.shift.assigned.tree</field>
        <field name="model">planning.slot.template</field>
        <field name="inherit_id" ref="planning.planning_slot_template_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="shift_assigned"/>
            </xpath>
        </field>
    </record>

    <!-- Shift Assigned in Planning Shift Template form -->
    <record id="planning_slot_template_shift_assigned_form" model="ir.ui.view">
        <field name="name">planning.slot.template.shift.assigned.form</field>
        <field name="model">planning.slot.template</field>
        <field name="inherit_id" ref="planning.planning_slot_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role_id']" position="before">
                <field name="shift_assigned"/>
            </xpath>
        </field>
    </record>

</odoo>
