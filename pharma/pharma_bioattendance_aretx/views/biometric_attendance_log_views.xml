<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  LIST VIEW  -->
    <record id="view_biometric_attendance_log_list" model="ir.ui.view">
        <field name="name">biometric.attendance.log.list</field>
        <field name="model">biometric.attendance.log</field>
        <field name="arch" type="xml">
            <list string="Attendance Logs" default_order="punch_time desc">
                <header>
                    <button name="action_process_attendance" string="Process" type="object" class="btn-primary" display="always"/>
                </header>
                <field name="attendance_date"/>
                <field name="punch_time"/>
                <field name="biometric_user_id"/>
                <field name="employee_name"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--  FORM VIEW  -->
    <record id="view_biometric_attendance_log_form" model="ir.ui.view">
        <field name="name">biometric.attendance.log.form</field>
        <field name="model">biometric.attendance.log</field>
        <field name="arch" type="xml">
            <form string="Attendance Log">
                <sheet>
                    <group>
                        <group string="Punch Details">
                            <field name="biometric_user_id"/>
                            <field name="employee_name"/>
                            <field name="attendance_date"/>
                            <field name="punch_time"/>
                        </group>
                        <group string="Links">
                            <field name="employee_id"/>
                            <field name="device_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- SEARCH VIEW -->
    <record id="view_biometric_attendance_log_search" model="ir.ui.view">
        <field name="name">biometric.attendance.log.search</field>
        <field name="model">biometric.attendance.log</field>
        <field name="arch" type="xml">
            <search string="Attendance Logs">

                <field name="employee_id"/>
                <field name="employee_name"/>
                <field name="biometric_user_id"/>
                <field name="device_id"/>

                <!-- STATUS FILTERS -->
                <filter
                    string="Imported"
                    name="filter_imported"
                    domain="[('state', '=', 'imported')]"
                />

                <filter
                    string="Processed"
                    name="filter_processed"
                    domain="[('state', '=', 'processed')]"
                />

                <separator/>

                <!-- DATE FILTERS -->
                <filter
                    string="Today"
                    name="today"
                    domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"
                />

                <filter
                    string="Yesterday"
                    name="yesterday"
                    domain="[('attendance_date', '=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"
                />

                <filter
                    string="This Week"
                    name="this_week"
                    domain="[('attendance_date', '>=', (context_today() - relativedelta(weekday=0)).strftime('%Y-%m-%d'))]"
                />

                <filter
                    string="This Month"
                    name="this_month"
                    domain="[('attendance_date','>=', context_today().strftime('%Y-%m-01')), ('attendance_date','&lt;=', context_today().strftime('%Y-%m-%d'))]"
                />

                <separator/>

                <!-- GROUP BY -->
                <filter
                    string="Employee"
                    name="group_employee"
                    context="{'group_by': 'employee_id'}"
                />

                <filter
                    string="Date"
                    name="group_date"
                    context="{'group_by': 'attendance_date'}"
                />

                <filter
                    string="Device"
                    name="group_device"
                    context="{'group_by': 'device_id'}"
                />

            </search>
        </field>
    </record>
    <!--  ACTION  -->
    <record id="action_biometric_attendance_log" model="ir.actions.act_window">
        <field name="name">Attendance Logs</field>
        <field name="res_model">biometric.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biometric_attendance_log_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> No attendance logs yet. Import from a device. </p>
        </field>
    </record>
</odoo>