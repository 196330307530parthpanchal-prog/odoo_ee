<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_biometric_device_list" model="ir.ui.view">
        <field name="name">biometric.device.list</field>
        <field name="model">biometric.device</field>
        <field name="arch" type="xml">
            <list string="Biometric Devices">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="port"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_sync"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_biometric_device_form" model="ir.ui.view">
        <field name="name">biometric.device.form</field>
        <field name="model">biometric.device</field>
        <field name="arch" type="xml">
            <form string="Biometric Device">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-secondary" icon="fa-plug" />
                    <button name="action_import_today" string="Import Today Attendance" type="object" class="btn-primary" icon="fa-download" />
                    <button name="action_open_import_wizard" string="Import Selected Date" type="object" class="btn-secondary" icon="fa-calendar" />
                    <button name="action_generate_hr_attendance" string="Generate HR Attendance" type="object" class="btn-success" icon="fa-check-circle" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Device Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection Settings">
                            <field name="ip_address"/>
                            <field name="port"/>
                            <field name="password"/>
                            <field name="timezone"/>
                        </group>
                        <group string="General">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_biometric_device_search" model="ir.ui.view">
        <field name="name">biometric.device.search</field>
        <field name="model">biometric.device</field>
        <field name="arch" type="xml">
            <search string="Biometric Devices">
                <field name="name"/>
                <field name="ip_address"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_biometric_device" model="ir.actions.act_window">
        <field name="name">Biometric Devices</field>
        <field name="res_model">biometric.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_biometric_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first biometric device
            </p>
        </field>
    </record>



</odoo>
