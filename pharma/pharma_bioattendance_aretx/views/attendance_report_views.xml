<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_pharma_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">pharma.attendance.report.wizard.form</field>
        <field name="model">pharma.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Attendance Excel">
                <sheet>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <separator string="Report Information"/>
                    <div class="alert alert-info" role="alert">
                        <p>
                            The Excel report will contain attendance
                            records for all employees within the
                            selected date range.
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_download_report" string="Generate" type="object" class="btn-primary"/>
                    <button name="action_finalize_attendance" string="Finalize Attendance" type="object" class="btn-primary" invisible="not can_finalize"/>
                    <button name="action_redo_finalization" string="Redo Finalization" type="object" class="btn-secondary" invisible="not can_redo_finalization"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>