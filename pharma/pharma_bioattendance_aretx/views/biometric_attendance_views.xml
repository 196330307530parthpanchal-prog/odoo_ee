<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- ===================================================== -->
    <!-- FORM VIEW                                             -->
    <!-- ===================================================== -->
    <record id="view_pharma_biometric_attendance_form" model="ir.ui.view">
        <field name="name">pharma.biometric.attendance.form</field>
        <field name="model">pharma.biometric.attendance</field>
        <field name="arch" type="xml">
            <form string="Biometric Attendance Import">
                <header>
                    <button name="action_upload_data" string="Upload Data" type="object" class="btn-primary" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reference" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="file"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <separator string="Processing Result"/>
                    <group>
                        <group>
                            <field name="total_records"/>
                            <field name="attendance_created"/>
                        </group>
                        <group>
                            <field name="unmatched_employees"/>
                            <field name="unmatched_punches"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LIST VIEW                                             -->
    <!-- ===================================================== -->

    <record id="view_pharma_biometric_attendance_list" model="ir.ui.view">
        <field name="name">pharma.biometric.attendance.list</field>
        <field name="model">pharma.biometric.attendance</field>
        <field name="arch" type="xml">
            <list string="Biometric Attendance Imports">
                <field name="name"/>
                <field name="filename"/>
                <field name="state"/>
                <field name="total_records"/>
                <field name="attendance_created"/>
                <field name="unmatched_employees"/>
                <field name="unmatched_punches"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- ACTION                                                -->
    <!-- ===================================================== -->

    <record id="action_pharma_biometric_attendance" model="ir.actions.act_window">
        <field name="name">Biometric Attendance</field>
        <field name="res_model">pharma.biometric.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a biometric attendance Excel file.
            </p>
            <p>
                The system will map biometric employee numbers
                and convert chronological punches against published
                scheduled shifts and identify mispunches.
            </p>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- BIOMETRIC ATTENDANCE MENU                            -->
    <!-- ===================================================== -->

    <menuitem id="menu_pharma_biometric_attendance_root" name="Biometric Attendance" parent="hr_attendance.menu_hr_attendance_root" sequence="50" />

    <!-- Existing Attendance Imports -->
    <menuitem id="menu_pharma_biometric_attendance" name="Attendance Imports" parent="menu_pharma_biometric_attendance_root" action="action_pharma_biometric_attendance" sequence="10" />

    <!-- Attendance Logs from Biometric Attendance Sync -->
    <menuitem id="menu_pharma_biometric_attendance_logs" name="Attendance Logs" parent="menu_pharma_biometric_attendance_root" action="action_biometric_attendance_log" sequence="20" />

    <!-- Devices from Biometric Attendance Sync -->
    <menuitem id="menu_pharma_biometric_devices" name="Devices" parent="menu_pharma_biometric_attendance_root" action="action_biometric_device" sequence="30" />
</odoo>