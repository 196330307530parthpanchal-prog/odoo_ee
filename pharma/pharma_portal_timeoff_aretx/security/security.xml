    <!-- Employee Self Service (ESS) is only for portal users in this group -->
    <record id="group_portal_employee" model="res.groups">
        <field name="name">Portal Employee</field>
        <field name="comment">Portal users who act as employees: they only see Employee Self Service in the portal.</field>
    </record>

    <record id="rule_private_request_company" model="ir.rule">
        <field name="name">Private details request: multi-company</field>
        <field name="model_id" ref="model_hr_employee_private_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
