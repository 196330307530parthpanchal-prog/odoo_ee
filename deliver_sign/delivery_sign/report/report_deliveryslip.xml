<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_delivery_sign" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div t-if="o.company_id.delivery_sign_enabled and o.company_id.delivery_sign_html"
                 class="o_delivery_sign mt-4" style="page-break-inside: avoid;">
                <t t-out="o.company_id.delivery_sign_html"/>
            </div>
        </xpath>
    </template>
</odoo>
