    <!-- >>> CHANGE (bubble layout): customer invoices / credit notes use Odoo's BUBBLE layout
         (web.external_layout_bubble). web.external_layout decides which layout a report uses;
         every other document keeps the company's own layout. -->
    <!-- <template id="ramsha_external_layout_bubble_switch" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="attributes">
            <attribute name="t-call">{{ 'web.external_layout_bubble' if (o and o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund')) else company.external_report_layout_id.sudo().key }}</attribute>
        </xpath> -->
        <!-- OLD (commented out): the t-else fallback node does not exist in Odoo 19's web.external_layout,
             so this xpath raised "cannot be located in parent view" on upgrade.
        <xpath expr="//t[@t-else='else'][@t-call='web.external_layout_standard']" position="attributes">
            <attribute name="t-call">{{ 'web.external_layout_bubble' if (o and o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund')) else 'web.external_layout_standard' }}</attribute>
        </xpath>
