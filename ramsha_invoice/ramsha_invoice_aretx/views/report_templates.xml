        <template id="ramsha_footer_bubble" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]/div[@t-field='company.report_footer']" position="replace">
            <t t-set="ramsha_footer" t-value="o and o._name == 'account.move' and o._ramsha_get_pos_footer()"/>
            <div t-if="ramsha_footer" class="border-top pt-2" style="white-space: pre-line;" t-out="ramsha_footer"/>
            <div t-else="" class="border-top pt-2" t-field="company.report_footer"/>
        </xpath>
    </template>
