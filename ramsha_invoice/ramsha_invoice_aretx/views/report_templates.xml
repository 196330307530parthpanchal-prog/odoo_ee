<odoo>
    <!-- Shared block, repeated per layout because XML can't loop -->

    <template id="ramsha_addr_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//ul[@name='company_address_list']" position="before">
            <t t-set="ramsha_address" t-value="o and o._name == 'account.move' and o._ramsha_get_pos_header_address()"/>
            <ul t-if="ramsha_address" class="list-unstyled" name="ramsha_pos_address">
                <li><strong t-out="company.name"/></li>
                <li style="white-space: pre-line;" t-out="ramsha_address"/>
            </ul>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="attributes">
            <attribute name="t-if" add="not ramsha_address" separator=" and "/>
        </xpath>
    </template>

